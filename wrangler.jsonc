{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "billsplit",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  "routes": [{ "pattern": "billsplit.atlesque.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "billsplit",
      "database_id": "ab8463b4-e203-4bbb-8bd5-403a6ee1a339",
      "migrations_dir": "migrations"
    }
  ],

  // The Nuxt SPA built by `pnpm build`. The Worker runs first for /api/* and for pages, where it adds
  // each page's canonical URL to the HTML; built JS and CSS under /_nuxt/ are served directly.
  "assets": {
    "directory": "./web/.output/public",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_nuxt/*"],
    "not_found_handling": "single-page-application"
  },

  // Expense attachments (receipts and invoices), served only to the group's members through /api.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "billsplit-attachments" }],

  // Sign-in emails. EMAIL_FROM must be on a domain onboarded to Cloudflare Email Sending.
  "send_email": [{ "name": "EMAIL" }],

  // Once a day: cleans up expired sign-in codes and sessions, and removes the attachments of
  // archived groups that have been quiet for 90 days.
  "triggers": { "crons": ["17 3 * * *"] },

  "vars": {
    "APP_URL": "https://billsplit.atlesque.dev",
    "EMAIL_FROM": "billsplit@atlesque.dev",
    // Comma-separated emails that can open /admin (users, groups, sign-ins, audit log).
    "ADMIN_EMAILS": "alexander@atlesque.media",

    // Cloudflare Access application protecting /admin and /api/admin/* on this hostname.
    // ACCESS_AUD is its "Application Audience (AUD) Tag". While either is empty, the admin API is off.
    "ACCESS_TEAM_DOMAIN": "https://atlesque.cloudflareaccess.com",
    "ACCESS_AUD": "d82a929380375d717916a317f95da8833f1812682581367600bff7441fc4e0f6"
  }
}
