{
  "name": "billsplit",
  "private": true,
  "license": "MIT",
  "description": "Split group expenses with friends. A Tricount-style app on Cloudflare Workers and D1.",
  "type": "module",
  "scripts": {
    "build": "nuxt generate web",
    "dev": "nuxt generate web && wrangler dev",
    "dev:web": "nuxt dev web",
    "deploy": "nuxt generate web && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "postinstall": "nuxt prepare web",
    "typecheck": "tsc --noEmit && nuxt typecheck web",
    "types": "wrangler types --strict-vars=false",
    "test": "node --test \"test/*.test.ts\"",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.144",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/i18n": "^10.6.0",
    "nuxt": "^4.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.146.0"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "jose": "^6.2.12"
  }
}
